# Copy this file to .env (same directory as docker-compose.yaml /
# docker-compose-https.yaml) and fill in real values. .env is gitignored --
# never commit real credentials.

# --- PostgreSQL --------------------------------------------------------
# Used to store user accounts (email/password logins, and later Google /
# WeChat identities). POSTGRES_PASSWORD has no default on purpose: both
# compose files refuse to start until it's set.
POSTGRES_USER=stock_portfolio
POSTGRES_PASSWORD=changeme
POSTGRES_DB=stock_portfolio

# --- Flask session signing ----------------------------------------------
# Signs the login session cookie. Generate a real one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Changing this value invalidates every existing logged-in session. No
# default on purpose: both compose files refuse to start until it's set.
SECRET_KEY=changeme

# --- Public URL of the site (docker-compose-https.yaml only) -----------
# Used to build the link inside verification emails, e.g.
# https://xiaodong.io/api/auth/verify-email?token=... . docker-compose.yaml
# (dev) already defaults this to http://localhost:5173, so it's only worth
# overriding here if your dev setup differs.
PUBLIC_BASE_URL=https://xiaodong.io

# --- Outbound email relay (docker-compose-https.yaml only) -------------
# Using Gmail SMTP as the relay -- free, 500 emails/day limit, no domain
# setup needed. To get RELAYHOST_USERNAME/PASSWORD below:
#   1. Turn on 2-Step Verification on the Gmail account, if not already on:
#      https://myaccount.google.com/signinoptions/two-step-verification
#   2. Generate an App Password: https://myaccount.google.com/apppasswords
#      Use the full Gmail address as RELAYHOST_USERNAME, and the generated
#      16-character app password (NOT your regular Gmail password) as
#      RELAYHOST_PASSWORD.
# IMPORTANT: Gmail's relay rejects/rewrites a From address it doesn't own,
# so MAIL_FROM_ADDRESS below MUST be set to that same Gmail address unless
# you've separately configured it as a verified "Send mail as" alias in
# Gmail settings. MAIL_SENDER_DOMAINS must also match (it's postfix's own
# local check on the From domain, separate from Gmail's check) -- it must
# be gmail.com, not xiaodong.io, or postfix rejects the mail before it even
# reaches Gmail.
# Leave these blank if you haven't done the above yet -- the postfix
# container is written to fail safe: with these unset it starts but simply
# refuses to relay any mail rather than sending from an
# unauthenticated/unverified source.
MAIL_HOSTNAME=smtp.gmail.com
MAIL_SENDER_DOMAINS=gmail.com
MAIL_RELAYHOST=[smtp.gmail.com]:587
MAIL_RELAYHOST_USERNAME=
MAIL_RELAYHOST_PASSWORD=
MAIL_FROM_ADDRESS=

# docker-compose.yaml (dev) uses the mailpit container instead and needs
# none of the MAIL_* vars above -- it never delivers real email, just
# captures it for viewing at http://localhost:8025.
