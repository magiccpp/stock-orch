# Copy this file to .env (same directory as docker-compose.yaml /
# docker-compose-https.yaml) and fill in real values. .env is gitignored --
# never commit real credentials.

# --- PostgreSQL --------------------------------------------------------
# Used to store user accounts (email/password logins, and later Google /
# WeChat identities). POSTGRES_PASSWORD has no default on purpose: both
# compose files refuse to start until it's set.
POSTGRES_USER=stock_portfolio
POSTGRES_PASSWORD=changeme
POSTGRES_DB=stock_portfolio

# --- Flask session signing ----------------------------------------------
# Signs the login session cookie. Generate a real one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Changing this value invalidates every existing logged-in session. No
# default on purpose: both compose files refuse to start until it's set.
SECRET_KEY=changeme

# --- Public URL of the site (docker-compose-https.yaml only) -----------
# Used to build the link inside verification emails, e.g.
# https://xiaodong.io/api/auth/verify-email?token=... . docker-compose.yaml
# (dev) already defaults this to http://localhost:5173, so it's only worth
# overriding here if your dev setup differs.
PUBLIC_BASE_URL=https://xiaodong.io

# --- Outbound email relay (postfix, both compose files) ----------------
# Using Brevo (https://app.brevo.com) as the relay -- 300 emails/day free,
# forever, no credit card. To get RELAYHOST_USERNAME/PASSWORD below:
#   1. Sign up at Brevo, then go to Senders, Domains & Dedicated IPs >
#      Domains > "Add a domain" and enter xiaodong.io.
#   2. Brevo gives you a DKIM TXT record (and a verification code) -- add
#      both as TXT records in xiaodong.io's DNS zone. SPF is NOT needed:
#      Brevo's own domain handles that on their end.
#   3. Once the domain shows verified, go to SMTP & API > SMTP tab. Use the
#      listed SMTP login (looks like 7xxxxx@smtp-brevo.com) as
#      RELAYHOST_USERNAME, and generate an SMTP key to use as
#      RELAYHOST_PASSWORD (NOT your Brevo account password).
# Leave these blank if you haven't done the above yet -- the postfix
# container is written to fail safe: with these unset it starts but simply
# refuses to relay any mail rather than sending from an
# unauthenticated/unverified source.
MAIL_HOSTNAME=mail.xiaodong.io
MAIL_SENDER_DOMAINS=xiaodong.io
MAIL_RELAYHOST=[smtp-relay.brevo.com]:587
MAIL_RELAYHOST_USERNAME=
MAIL_RELAYHOST_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@xiaodong.io

# --- Dev mail target (docker-compose.yaml only) -------------------------
# By default dev sends through mailpit -- a fake SMTP server that captures
# everything at http://localhost:8025 instead of actually delivering it, so
# you can test the login flow without spamming real inboxes. That's almost
# always what you want. If you specifically need dev to deliver to a real
# inbox (e.g. testing what the email itself looks like end to end), fill in
# the Brevo vars above and switch dev to the same postfix relay
# docker-compose-https.yaml uses:
# SMTP_HOST=postfix
# SMTP_PORT=587
